# Copy to .env and fill in. Never commit .env.

# Deployer key. Use a throwaway key for testnets. Mainnet deployments are
# executed from the treasury Safe, not from this key.
DEPLOYER_PRIVATE_KEY=

# RPC endpoints. The mainnet endpoint needs archive access for forked tests.
ETHEREUM_MAINNET_RPC=
ETHEREUM_SEPOLIA_RPC=
POLYGON_AMOY_RPC=
BSC_TESTNET_RPC=
BSC_MAINNET_RPC=

# Contract verification
ETHERSCAN_API_KEY=

# Set FORK=1 to run test/mainnet-fork.e2e.ts against pinned mainnet state
FORK=

# Set COVERAGE=true to disable viaIR, which solidity-coverage cannot instrument
COVERAGE=
