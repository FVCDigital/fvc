# Transak Configuration
# Get your API key from https://dashboard.transak.com/dashboard
NEXT_PUBLIC_TRANSAK_API_KEY=your_transak_api_key_here
NEXT_PUBLIC_TRANSAK_ENVIRONMENT=STAGING

# MoonPay Configuration
# Get your API key from https://dashboard.moonpay.com
NEXT_PUBLIC_MOONPAY_API_KEY=pk_test_xxx
NEXT_PUBLIC_MOONPAY_ENVIRONMENT=sandbox

# Change to production when ready to go live:
# NEXT_PUBLIC_MOONPAY_ENVIRONMENT=production

# Other existing environment variables...
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=...
# etc.
